---
import { formatPrice, mediaSrc } from '../lib/cms'
import type { MenuItem } from '../lib/types'

const { items, title, intro } = Astro.props as {
  items: MenuItem[]
  title?: string | null
  intro?: string | null
}
---

<section class="section" id="entradas">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Porções</p>
      <h2>{title}</h2>
      <p>{intro}</p>
    </div>
    <div class="sides">
      {items.map((item) => (
        <article class="side-card">
          {mediaSrc(item.image, item.imageUrl) && (
            <img src={mediaSrc(item.image, item.imageUrl)} alt={item.name} />
          )}
          <div>
            <h3>{item.name}</h3>
            <p>{item.description || item.ingredients}</p>
            {item.price != null && <p class="price">{formatPrice(item.price)}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
