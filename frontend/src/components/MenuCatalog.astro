---
import { extraInfo, formatPrice, mediaSrc } from '../lib/cms'
import type { MenuCategory, MenuItem } from '../lib/types'

const { groups, mode } = Astro.props as {
  groups: { category: MenuCategory; items: MenuItem[] }[]
  mode: 'view' | 'order'
}
---

{groups.map(({ category, items: groupItems }) => (
  <div class="menu-group" id={category.slug}>
    <h2>{category.name}</h2>
    {category.description && <p>{category.description}</p>}
    <div class="sides">
      {groupItems.map((item) => {
        const src = mediaSrc(item.image, item.imageUrl)
        const description = item.description || item.ingredients || ''
        const extras = extraInfo(item)
        const addons = item.addons || []
        return (
          <article
            class="side-card side-card-clickable"
            tabindex="0"
            role="button"
            data-item-open
            data-id={String(item.id)}
            data-name={item.name}
            data-description={description}
            data-ingredients={item.ingredients || ''}
            data-image={src}
            data-price={item.price ?? ''}
            data-tag={item.tag || ''}
            data-extra={JSON.stringify(extras)}
            data-addons={JSON.stringify(addons)}
          >
            {src && <img src={src} alt={item.name} />}
            <div>
              {item.tag && <p class="eyebrow">{item.tag}</p>}
              <h3>{item.name}</h3>
              <p>{description}</p>
              {extras.badges.length > 0 && (
                <ul class="item-badges">
                  {extras.badges.map((badge) => (
                    <li>{badge}</li>
                  ))}
                </ul>
              )}
              {item.price != null && <p class="price">{formatPrice(item.price)}</p>}
              {mode === 'order' && (
                <p class="order-hint">{addons.length ? 'Toque para personalizar' : 'Toque para pedir'}</p>
              )}
              {mode === 'view' && addons.length > 0 && (
                <p class="order-hint">{addons.length} {addons.length === 1 ? 'adicional' : 'adicionais'}</p>
              )}
            </div>
          </article>
        )
      })}
    </div>
  </div>
))}
