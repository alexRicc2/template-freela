---
import Layout from '../layouts/Layout.astro'
import ItemDialog from '../components/ItemDialog.astro'
import MenuCatalog from '../components/MenuCatalog.astro'
import ReviewBanner from '../components/ReviewBanner.astro'
import { categorySlug, DELIVERY_WHATSAPP, getRestaurantContent } from '../lib/cms'
import { restaurantStatus } from '../lib/hours'

const { site, items, categories } = await getRestaurantContent()
const status = restaurantStatus(site)
const groups = categories
  .map((category) => ({
    category,
    items: items.filter((item) => categorySlug(item) === category.slug),
  }))
  .filter((group) => group.items.length)
---

<Layout site={site} title="Delivery">
  <section
    class="section delivery-page"
    data-delivery-app
    data-restaurant={site.restaurantName}
    data-wa={DELIVERY_WHATSAPP}
    data-accept-orders={status.acceptOrders ? 'true' : 'false'}
  >
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{site.deliveryLabel || 'Delivery'}</p>
        <h2>Peça para casa</h2>
        <p>
          Escolha os itens, personalize os adicionais e finalize o pedido. Toque em um prato para o
          copy, os opcionais e o carrinho. O pedido vai para o WhatsApp com o seu endereço.
        </p>
        <p class="closed-note" data-closed-note hidden={status.acceptOrders}>
          {site.closedMessage || status.detail || status.label}
        </p>
      </div>
      <MenuCatalog groups={groups} mode="order" />
    </div>
  </section>

  <div class="cart-bar">
    <div class="wrap">
      <p class="cart-summary" data-cart-summary>Carrinho vazio</p>
      <button class="btn btn-gold" type="button" data-cart-finish disabled>
        {status.acceptOrders ? 'Finalizar pedido' : 'Casa fechada'}
      </button>
    </div>
  </div>

  <dialog class="checkout-dialog" data-checkout-dialog>
    <button type="button" class="dialog-close" data-checkout-close aria-label="Fechar">×</button>
    <div class="checkout-body">
      <p class="eyebrow">Checkout</p>
      <h2>Dados de entrega</h2>
      <p>Confira o pedido e informe o endereço. Ao enviar, abriremos o WhatsApp com a mensagem pronta.</p>

      <ul class="cart-lines" data-checkout-lines></ul>
      <p class="checkout-total">Total: <strong data-checkout-total>0,00</strong></p>

      <form class="form" data-checkout-form>
        <label>
          Nome completo
          <input type="text" name="nome" required autocomplete="name" />
        </label>
        <label>
          Telefone / WhatsApp
          <input type="tel" name="telefone" required autocomplete="tel" />
        </label>
        <label>
          CEP
          <input type="text" name="cep" required autocomplete="postal-code" inputmode="numeric" />
        </label>
        <label>
          Cidade
          <input type="text" name="cidade" required autocomplete="address-level2" value="São José do Rio Preto" />
        </label>
        <label class="full">
          Rua
          <input type="text" name="rua" required autocomplete="street-address" />
        </label>
        <label>
          Número
          <input type="text" name="numero" required />
        </label>
        <label>
          Bairro
          <input type="text" name="bairro" required />
        </label>
        <label class="full">
          Complemento (opcional)
          <input type="text" name="complemento" />
        </label>
        <label class="full">
          Observações (opcional)
          <textarea name="observacoes" placeholder="Ponto de referência, ponto da carne, sem cebola..."></textarea>
        </label>
        <div class="full">
          <button class="btn btn-gold" type="submit">Enviar pedido no WhatsApp</button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog class="checkout-dialog thanks-dialog" data-thanks-dialog>
    <button type="button" class="dialog-close" data-thanks-close aria-label="Fechar">×</button>
    <div class="checkout-body">
      <p class="eyebrow">Pedido enviado</p>
      <h2>Agora é só confirmar no WhatsApp</h2>
      <p>A mensagem já foi aberta. Se quiser, avalie a casa — o mesmo convite da placa NFC.</p>
      <ReviewBanner site={site} />
      <p>
        <a class="btn btn-ghost" href="/avaliar">Página de avaliação</a>
      </p>
    </div>
  </dialog>
  <ItemDialog order />
</Layout>

<script>
  import '../scripts/delivery-cart.ts'
</script>
