# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_DB_PASSWORD=

# Payload talks to Postgres directly (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4321

# Astro
PUBLIC_PAYLOAD_URL=http://localhost:3000
PAYLOAD_API_URL=http://localhost:3000
