# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_DB_PASSWORD=

# Payload → Supabase shared pooler, session mode (port 5432). Required on Vercel (IPv4).
# User is postgres.YOUR_PROJECT_REF. URL-encode /, @, # in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4321

# Astro
PUBLIC_PAYLOAD_URL=http://localhost:3000
PAYLOAD_API_URL=http://localhost:3000
